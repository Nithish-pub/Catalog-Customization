    "compression": "^1.7.4",
    "winston": "^3.8.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.3",
    "jest": "^29.5.0",
    "supertest": "^6.3.3",
    "chai": "^4.3.7",
    "sinon": "^15.0.3"
